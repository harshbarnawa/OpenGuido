{
  "name": "openguido-docs",
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/cpp", "dest": "/cpp.html" },
    { "src": "/python", "dest": "/python.html" },
    { "src": "/git", "dest": "/git.html" },
    { "src": "/linux", "dest": "/linux.html" },
    { "src": "/snippet", "dest": "/snippet.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
